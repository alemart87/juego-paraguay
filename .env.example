# PostgreSQL (Render inyecta la URL interna desde render.yaml)
DATABASE_URL=postgresql://juego_paraguay:password@localhost:5432/juego_paraguay

# Secreto aleatorio para convertir correo/teléfono en un hash irreversible.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEADERBOARD_SECRET=

# Venice AI: se acepta VENICE_API_KEY; los aliases antiguos siguen funcionando.
VENICE_API_KEY=
VENICE_MODEL=zai-org-glm-5-2

# Render monta el disco persistente aquí. En local se puede usar ./persistent.
PERSISTENT_DIR=./persistent

# El juego usa registro opcional propio para el ranking, no Better Auth.
VITE_AUTH_ENABLED=false

# URL pública final, usada en documentación y futuros callbacks.
PUBLIC_SITE_URL=http://localhost:8080
