# PostgreSQL (Render inyecta la URL interna desde render.yaml)
DATABASE_URL=postgresql://juego_paraguay:password@localhost:5432/juego_paraguay

# Secreto aleatorio para convertir correo/teléfono en un hash irreversible.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEADERBOARD_SECRET=

# Venice AI: se acepta VENICE_API_KEY; los aliases antiguos siguen funcionando.
VENICE_API_KEY=
VENICE_MODEL=zai-org-glm-5-2

# Render monta el disco persistente aquí. En local se puede usar ./persistent.
PERSISTENT_DIR=./persistent

# El juego usa registro opcional propio para el ranking, no Better Auth.
VITE_AUTH_ENABLED=false

# URL pública final, usada en documentación y futuros callbacks.
PUBLIC_SITE_URL=https://www.influencerspy.pro

# Whop SDK: una Account API key crea planes one_time y checkouts al primer clic.
# Para el primer setup usá una Account API key con rol Admin; luego podés reducir permisos.
WHOP_API_KEY=

# Secreto de firma generado una sola vez al crear el webhook en Whop.
# Endpoint: https://www.influencerspy.pro/api/webhooks/whop
WHOP_WEBHOOK_SECRET=

# Overrides opcionales para reutilizar enlaces existentes sin llamar a la API.
WHOP_CHECKOUT_ARSENAL=
WHOP_CHECKOUT_TERERE=
WHOP_CHECKOUT_POMBERO=
WHOP_CHECKOUT_ENERGIA=
WHOP_CHECKOUT_INMUNIDAD=
WHOP_CHECKOUT_ARMADURA=
WHOP_CHECKOUT_LUISON=
WHOP_CHECKOUT_AVANCE=
